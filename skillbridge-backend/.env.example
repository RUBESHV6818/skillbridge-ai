MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge_ai
JWT_SECRET=supersecretkey
PORT=5001
# AI provider (Groq is selected automatically when GROQ_API_KEY is present;
# set AI_PROVIDER explicitly to choose. Keep provider keys on the backend only.)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Optional code runner for Java/Python mock-interview sample execution.
# Defaults to the public Piston API; for production, point this at your own protected Piston instance.
# PISTON_API_URL=https://emkc.org/api/v2/piston

# Optional alternative provider:
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_google_ai_studio_api_key
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# SMTP email delivery (leave blank for local development console links)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_REQUIRE_TLS=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_DEV_MODE=console
APP_BASE_URL=http://localhost:5173

# Weekly roadmap reminder schedule (defaults to Mondays at 9 AM India time)
ROADMAP_REMINDER_TIMEZONE=Asia/Kolkata
